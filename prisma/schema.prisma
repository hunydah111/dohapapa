// Dohapapa — 부부 프로필 기반 주거지 탐색 의사결정 도구
// DB: Postgres (Neon). DATABASE_URL=pooled(런타임), DIRECT_URL=direct(마이그레이션).
//
// 컴플라이언스 주의: 사용자 프로필(소득·자산·직장)은 DB에 저장하지 않는다.
// 요청당 1회 계산 후 폐기. 영속 데이터는 공개 데이터(실거래가)와 캐시뿐.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Complex {
  id              String        @id @default(cuid())
  name            String
  sigungu         String
  dongName        String
  buildYear       Int?
  totalHouseholds Int?
  latitude        Float?
  longitude       Float?
  // 가족 입지 점수용 보조 데이터 (MVP: 시드/추정값, 추후 학교알리미 등으로 보강)
  nearestElemSchoolM Int? // 최단 초등학교 도보 거리(m)
  nearestSubwayM     Int? // 최단 지하철역 거리(m)
  createdAt       DateTime      @default(now())

  transactions    Transaction[]

  @@unique([sigungu, dongName, name])
  @@index([sigungu, dongName])
}

model Transaction {
  id        String   @id @default(cuid())
  complexId String
  complex   Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)

  dealDate  DateTime
  priceKrw  BigInt
  area      Float
  floor     Int?
  source    String   @default("MOLIT")

  @@index([complexId, dealDate])
  @@index([complexId, area, dealDate])
}

// 통근 시간 계산 결과 캐시 — 동일 출발지·단지·교통수단 조합의 재계산을 막는다.
// 출발지는 좌표를 소수 3자리(약 100m)로 반올림한 키로 묶는다.
// (회의에서 데이터 사이언티스트가 지적한 "API 호출 폭발" 대응의 핵심.)
model CommuteCache {
  id         String   @id @default(cuid())
  originKey  String   // "37.513,127.086" — lat,lng rounded to 3 decimals
  complexId  String
  mode       String   // "transit" | "car"
  minutes    Int
  computedAt DateTime @default(now())

  @@unique([originKey, complexId, mode])
  @@index([originKey])
}

// 집계 카운터 — 줄세우기(집 찾기 유형 분포 등)용 비-PII 누적 카운트.
// 컴플라이언스: 프로필·개인정보 없음. "type:commute" 같은 범주 키의 증가값만 저장한다.
// (사용자를 식별하지 않으며, No-PII 원칙을 깨지 않는다.)
model AggCounter {
  key       String   @id // 예: "type:commute"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}
