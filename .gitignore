# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# og-check.mjs 가 저장하는 라이브 OG 이미지 미리보기(검증용, 버전관리 불필요)
scripts/.og-preview/

# typescript
*.tsbuildinfo
next-env.d.ts

# database files
*.db
*.db-journal
prisma/dev.db*
prisma/_dump.json

# claude code local settings
.claude/settings.local.json

# 초기 기획 잡문서 — 정식 아키텍처 문서(docs/architecture.md 등)와 달리
# 버전 관리 대상이 아닌 일회성 브리핑 초안.
docs/ppt-style-brief.md

# shot.cjs / shot-result.cjs 가 작업 루트에 떨구는 임시 스크린샷
shot-*.png

# 비집고와 무관한 별도 프로젝트 — 같은 작업 폴더에 있지만 저장소엔 X
tennis-contact-simulator/
