# Dev (SQLite — works out of the box)
DATABASE_URL="file:./dev.db"

# Production example (Supabase / Vercel Postgres) — also change schema.prisma provider to "postgresql"
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?sslmode=require"

# 국토교통부 실거래가 공개 API (data.go.kr → 아파트 매매 실거래가 상세 자료)
# 비워두면 scripts/fetch-molit.ts 가 동작하지 않음. 시드 데이터로는 앱이 그대로 돌아감.
MOLIT_API_KEY=""

# Kakao REST API 키 (https://developers.kakao.com → 내 애플리케이션 → 플랫폼 키 → REST API 키)
# 두 가지 용도에 같은 키를 쓴다:
#  - 회사명·단지 지오코딩 (src/lib/geocode.ts — Local API)
#  - 통근 시간 길찾기   (src/lib/commute — 카카오 Navi 자동차 길찾기 API)
# 비워두면 지오코딩은 내장 지역 사전, 통근은 거리 기반 mock 추정으로 폴백.
# 주의: 앱 설정에서 "카카오맵" 서비스를 ON 으로 켜야 Local API 가 동작함.
KAKAO_REST_KEY=""

# 사이트 공개 URL (sitemap, robots, OG 메타데이터에 사용)
# 미설정 시 placeholder 도메인이 사용됨 — 배포 전 반드시 실제 도메인으로 교체
NEXT_PUBLIC_SITE_URL=""

# 운영자 연락 이메일 (개인정보처리방침·이용약관·연락처 페이지에 노출)
# 미설정 시 코드에 박힌 fallback 사용
NEXT_PUBLIC_CONTACT_EMAIL=""

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX)
# Google Analytics → 관리 → 데이터 스트림 → 측정 ID
# 비워두면 GA 스크립트는 로드되지 않음 (Vercel Analytics 는 별도 동작).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
